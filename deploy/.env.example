# Required: random secret, generate with `openssl rand -hex 32`
GOTERO_SECRET=

# The URL clients use to reach gotero (behind a reverse proxy: the https URL)
GOTERO_PUBLIC_URL=http://localhost:8080

# First admin account, created on startup if no admin exists yet
GOTERO_ADMIN_USERNAME=admin
GOTERO_ADMIN_PASSWORD=
GOTERO_ADMIN_EMAIL=

POSTGRES_PASSWORD=gotero

# File storage: local (default), s3 or webdav
GOTERO_STORAGE_BACKEND=local
# GOTERO_STORAGE_S3_ENDPOINT=s3:9000
# GOTERO_STORAGE_S3_BUCKET=zotero
# GOTERO_STORAGE_S3_ACCESS_KEY=gotero
# GOTERO_STORAGE_S3_SECRET_KEY=gotero-secret
# GOTERO_STORAGE_S3_USE_SSL=false
# GOTERO_STORAGE_WEBDAV_URL=http://webdav:8080/
# GOTERO_STORAGE_WEBDAV_USERNAME=gotero
# GOTERO_STORAGE_WEBDAV_PASSWORD=gotero
